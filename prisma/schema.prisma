generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  user
  assistant
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model LegalCodeChunk {
  id             String                      @id @default(cuid())
  corpusId       String                      @map("corpus_id")
  chunkId        String                      @map("chunk_id")
  articleNumber  String                      @map("article_number")
  content        String                      @db.Text
  charCount      Int                         @map("char_count")
  metadata       Json
  embedding      Unsupported("vector(3072)")
  embeddingModel String                      @map("embedding_model")
  embeddedAt     DateTime                    @map("embedded_at")
  importedAt     DateTime                    @default(now()) @updatedAt @map("imported_at")

  @@unique([corpusId, chunkId])
  @@index([corpusId])
  @@index([corpusId, articleNumber])
  @@map("legal_code_chunks")
}
